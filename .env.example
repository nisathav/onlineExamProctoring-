# Copy to .env and change every value. Never commit .env.
ENVIRONMENT=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

POSTGRES_USER=proctor
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=proctoring

MINIO_ACCESS_KEY=proctor-minio
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET=evidence
PRESIGNED_URL_EXPIRY_SECONDS=300

FRONTEND_ORIGIN=http://localhost:3000
EVIDENCE_RETENTION_DAYS=30
GAZE_MODEL_PATH=models/gaze_model.keras

# Dev seed users (only used when SEED_DATA=true)
SEED_STAFF_USER=staff1
SEED_STAFF_PASSWORD=staffpass123
SEED_STUDENT_USER=student1
SEED_STUDENT_PASSWORD=studentpass123

# Production only (docker-compose.prod.yml)
DOMAIN=exam.example.com
ACME_EMAIL=admin@example.com

# MinIO image: official minio/minio is gone from Docker Hub and auth-only on quay.io;
# pgsty/minio is a community drop-in rebuild. Override here if needed.
MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
